#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "devtmpfs: using static nodes"
mkdir -p /dev/shm /run /var/run
mount -t tmpfs -o mode=1777 tmpfs /dev/shm 2>/dev/null || true
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || true

echo ""
echo "==============================================="
echo "  DANOS-Open live system (kernel 6.12, mgrd)"
echo "==============================================="

# network drivers (QEMU e1000 and virtio-net)
insmod /modules/e1000.ko 2>/dev/null || echo "e1000 insmod failed"
insmod /modules/failover.ko 2>/dev/null || true
insmod /modules/net_failover.ko 2>/dev/null || true
insmod /modules/virtio_pci.ko 2>/dev/null || true
insmod /modules/virtio_net.ko 2>/dev/null || echo "virtio-net insmod failed"
if test -f /modules/uio.ko; then insmod /modules/uio.ko 2>/dev/null || echo "uio insmod failed"; else echo "uio module absent"; fi
if test -f /modules/uio_pci_generic.ko; then insmod /modules/uio_pci_generic.ko 2>/dev/null || echo "uio-pci-generic insmod failed"; else echo "uio-pci-generic module absent"; fi

ip link set lo up
# QEMU user-mode networking: static address on eth0
if ip link show eth0 >/dev/null 2>&1; then
    ip addr add 10.0.2.15/24 dev eth0
    ip link set eth0 up
    ip route add default via 10.0.2.2 2>/dev/null
    echo "eth0: 10.0.2.15/24 up"
fi

if test -e /vpp-dpdk.enabled; then
    mkdir -p /dev/hugepages /run/vpp /var/log/vpp
    mount -t hugetlbfs none /dev/hugepages 2>/dev/null || true
    # Prefer the complete Debian trixie VPP runtime tree.  /lib also
    # contains the base live-image libc and must remain a fallback only.
    export LD_LIBRARY_PATH=/lib/x86_64-linux-gnu:/lib
    echo "--- starting optional VPP/DPDK guest profile"
    echo "--- VPP binary probe ---"
    /usr/bin/vpp --version > /var/log/vpp/vpp-probe.log 2>&1 || true
    cat /var/log/vpp/vpp-probe.log > /dev/console 2>&1
    /usr/bin/vpp -c /etc/vpp/startup.conf >/var/log/vpp/vpp-console.log 2>&1 &
    sleep 2
    echo "--- VPP guest startup log ---"
    cat /var/log/vpp/vpp-console.log > /dev/console 2>&1
fi

export MGRD_NETLINK_REAL=1   # VM root: program the real kernel
echo "--- starting mgrd (gNMI :59200, metrics :59201, netlink real)"
mgrd --port 59200 --metrics-port 59201 --wal /tmp/mgrd.wal --seed &
sleep 1

# K4-in-VM: provision a route via gNMI and show the kernel FIB
(
    sleep 2
    if ! command -v gnmic >/dev/null 2>&1; then
        echo "--- [demo] gnmic unavailable; skipping gNMI route demo" > /dev/console
        exit 0
    fi
    echo "--- [demo] gnmic set route 172.16.0.0/16 via 10.0.2.2"
    gnmic -a 127.0.0.1:59200 --insecure set \
        --update '/routes/route[prefix=172.16.0.0/16]:::json_ietf:::{"gateway":"10.0.2.2"}' \
        > /dev/console 2>&1
    sleep 2
    echo "--- [demo] kernel FIB (ip route show):"
    ip route show > /dev/console 2>&1
    echo "--- [demo] kernel FIB (/proc/net/route):"
    cat /proc/net/route > /dev/console 2>&1
) &

echo "--- live system ready. shell:"
exec /bin/busybox sh
