#!/bin/busybox sh
/bin/busybox --install -s /bin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || echo "devtmpfs: using static nodes"
echo "DANOS-INIT-ENTER" > /dev/console 2>/dev/null || true
echo "DANOS-INIT-ENTER" > /dev/tty0 2>/dev/null || true
mkdir -p /dev/shm /run /var/run
mount -t tmpfs -o mode=1777 tmpfs /dev/shm 2>/dev/null || true
mount -t tmpfs -o mode=0755 tmpfs /run 2>/dev/null || true

if test -f /etc/danos/bridge.env; then
    . /etc/danos/bridge.env
fi
if test -f /etc/danos/build-info.env; then
    . /etc/danos/build-info.env
fi
if test -f /etc/danos/vpp-traffic.env; then
    . /etc/danos/vpp-traffic.env
fi
if test -f /etc/danos/network.env; then
    . /etc/danos/network.env
fi
echo "DANOS VPP health_probe=${DANOS_VPP_HEALTH_PROBE:-0} restart_test=${DANOS_VPP_RESTART_TEST:-0}" > /dev/console
for pci_dev in /sys/bus/pci/devices/*; do
    test -r "$pci_dev/class" || continue
    test "$(cat "$pci_dev/class" 2>/dev/null)" = 0x020000 || continue
    echo "PCI-NIC $(basename "$pci_dev") vendor=$(cat "$pci_dev/vendor" 2>/dev/null) device=$(cat "$pci_dev/device" 2>/dev/null)" > /dev/console
done

echo "" > /dev/console
echo "===============================================" > /dev/console
echo "  DANOS-Open live system (kernel 6.12, mgrd)" > /dev/console
echo "===============================================" > /dev/console
echo "" > /dev/tty0 2>/dev/null || true
echo "===============================================" > /dev/tty0 2>/dev/null || true
echo "  DANOS-Open live system (kernel 6.12, mgrd)" > /dev/tty0 2>/dev/null || true
echo "===============================================" > /dev/tty0 2>/dev/null || true

# Physical USB keyboards need their host-controller and HID modules in this
# minimal initramfs; a tty shell alone does not make USB input available.
say_live() {
    echo "$*" > /dev/console 2>/dev/null || true
    echo "$*" > /dev/ttyS0 2>/dev/null || true
}
say_live_file() {
    while IFS= read -r live_line; do
        say_live "$live_line"
    done < "$1"
}
if test -n "${DANOS_BUILD_COMMIT:-}"; then
    say_live "DANOS-BUILD commit=${DANOS_BUILD_COMMIT} source_dirty=${DANOS_BUILD_SOURCE_DIRTY:-unknown} iso=${DANOS_BUILD_ISO:-unknown} no_rx_interrupts=${DANOS_BUILD_DPDK_NO_RX_INTERRUPTS:-unknown} utc=${DANOS_BUILD_UTC:-unknown}"
fi
for module in usb_common usbcore input_core hid xhci_hcd xhci_pci \
    ehci_hcd ehci_pci uhci_hcd ohci_hcd ohci_pci usbhid hid_generic; do
    if test -f "/modules/${module}.ko"; then
        insmod "/modules/${module}.ko" 2>/dev/null || \
            say_live "USB-INPUT module load failed: ${module}"
    fi
done
say_live "USB-INPUT modules initialized"
sleep 2
if test -r /proc/bus/input/devices && grep -Eq 'Handlers=.*kbd' /proc/bus/input/devices; then
    say_live "USB-KEYBOARD detected"
else
    say_live "USB-KEYBOARD not detected; check USB controller/port"
fi

# network drivers (QEMU management NICs; DPDK owns dataplane NICs)
if test ! -e /vpp-dpdk.enabled; then
    insmod /modules/e1000.ko 2>/dev/null || echo "e1000 insmod failed"
    insmod /modules/vmxnet3.ko 2>/dev/null || echo "vmxnet3 insmod failed"
fi
insmod /modules/failover.ko 2>/dev/null || true
insmod /modules/net_failover.ko 2>/dev/null || true
insmod /modules/virtio_pci.ko 2>/dev/null || true
insmod /modules/virtio_net.ko 2>/dev/null || echo "virtio-net insmod failed"
if test -f /modules/uio.ko; then insmod /modules/uio.ko 2>/dev/null || echo "uio insmod failed"; else echo "uio module absent"; fi
if test -f /modules/uio_pci_generic.ko; then insmod /modules/uio_pci_generic.ko 2>/dev/null || echo "uio-pci-generic insmod failed"; else echo "uio-pci-generic module absent"; fi
if test "${DANOS_BUILD_DPDK_BIND_DRIVER:-none}" != none; then
    /bin/sh /bin/bind_dpdk_pci.sh > /tmp/dpdk-pci-bind.log 2>&1
    dpdk_bind_rc=$?
    say_live_file /tmp/dpdk-pci-bind.log
    test "$dpdk_bind_rc" -eq 0 || say_live "DPDK-PCI-BIND-RESULT FAIL rc=$dpdk_bind_rc"
fi

ip link set lo up
# QEMU user-mode networking: static address on eth0
if ip link show eth0 >/dev/null 2>&1; then
    # The QEMU topology uses a direct socket link to FRR-1 for ZAPI.
    # Keep the user-mode address as a compatibility fallback, and add the
    # deterministic point-to-point management address used by the bridge.
    ip addr add "${DANOS_MGMT_ADDR:-10.0.2.15/24}" dev eth0 2>/dev/null || true
    ip addr add 10.0.3.1/24 dev eth0 2>/dev/null || true
    ip link set eth0 up
    ip route add default via "${DANOS_MGMT_GW:-10.0.2.2}" 2>/dev/null || true
    echo "eth0: ${DANOS_MGMT_ADDR:-10.0.2.15/24} and 10.0.3.1/24 up"
    if test -n "${DANOS_PEER_ADDR2:-}" && ip link show eth1 >/dev/null 2>&1; then
        ip addr add "$DANOS_PEER_ADDR2" dev eth1 2>/dev/null || true
        ip link set eth1 up 2>/dev/null || true
        echo "eth1: $DANOS_PEER_ADDR2 up" > /dev/console
    fi
    # BusyBox ip in the minimal peer image may not implement `neigh replace`.
    # Try replace first, then add, and expose the resulting table for the
    # serial verifier; normal ARP remains the fallback when both are absent.
    for neigh_spec in \
        "${DANOS_PEER_NEIGH1_IP:-} ${DANOS_PEER_NEIGH1_MAC:-}" \
        "${DANOS_PEER_NEIGH2_IP:-} ${DANOS_PEER_NEIGH2_MAC:-}"; do
        set -- $neigh_spec
        test -n "${1:-}" && test -n "${2:-}" || continue
        ip neigh replace "$1" lladdr "$2" nud permanent dev eth0 2>/dev/null || \
            ip neigh add "$1" lladdr "$2" nud permanent dev eth0 2>/dev/null || true
    done
    ip addr show dev eth0 > /dev/console 2>&1 || true
    ip route show > /dev/console 2>&1 || true
    ip neigh show > /dev/console 2>&1 || true
    if test "${DANOS_TRAFFIC_COUNT:-0}" -gt 0 && test -n "${DANOS_TRAFFIC_TARGETS:-}"; then
        sleep 15
        traffic_ok=1
        for traffic_target in ${DANOS_TRAFFIC_TARGETS}; do
            bench_start=$(awk '{printf "%d", $1 * 100}' /proc/uptime 2>/dev/null || echo 0)
            if ! ping -c "${DANOS_TRAFFIC_COUNT}" -i "${DANOS_TRAFFIC_INTERVAL:-0.01}" -W 1 "$traffic_target" > "/tmp/ping-${traffic_target}.log" 2>&1; then
                traffic_ok=0
            fi
            bench_end=$(awk '{printf "%d", $1 * 100}' /proc/uptime 2>/dev/null || echo "$bench_start")
            bench_cs=$((bench_end - bench_start))
            test "$bench_cs" -gt 0 || bench_cs=1
            bench_pps=$(awk -v n="${DANOS_TRAFFIC_COUNT}" -v cs="$bench_cs" 'BEGIN { printf "%.2f", n * 100 / cs }')
            echo "PEER-TRAFFIC-BENCH target=$traffic_target packets=${DANOS_TRAFFIC_COUNT} elapsed_cs=$bench_cs pps=$bench_pps" > /dev/console
            cat "/tmp/ping-${traffic_target}.log" > /dev/console 2>&1 || true
        done
        test "$traffic_ok" = 1 && echo "PEER-TRAFFIC PASS" > /dev/console || echo "PEER-TRAFFIC FAIL" > /dev/console
    fi
fi

if test -e /vpp-dpdk.enabled; then
    mkdir -p /dev/hugepages /run/vpp /var/log/vpp
    mount -t hugetlbfs none /dev/hugepages 2>/dev/null || true
    # Prefer the complete Debian trixie VPP runtime tree.  /lib also
    # contains the base live-image libc and must remain a fallback only.
    export LD_LIBRARY_PATH=/lib/x86_64-linux-gnu:/lib
    echo "--- starting optional VPP/DPDK guest profile"
    echo "--- VPP binary probe ---"
    /usr/bin/vpp --version > /var/log/vpp/vpp-probe.log 2>&1 || true
    say_live_file /var/log/vpp/vpp-probe.log
    /usr/bin/vpp -c /etc/vpp/startup.conf >/var/log/vpp/vpp-console.log 2>&1 &
    sleep 2
    echo "--- VPP guest startup log ---"
    say_live_file /var/log/vpp/vpp-console.log
    for vpp_wait in $(seq 1 30); do
        test -S /run/vpp/api.sock && break
        sleep 1
    done
    test -S /run/vpp/api.sock && say_live "VPP API socket: ready" || say_live "VPP API socket: missing"
    test -S /run/vpp/stats.sock && say_live "VPP stats socket: ready" || say_live "VPP stats socket: missing"
    vpp_if1=GigabitEthernet0/2/0
    vpp_if2=GigabitEthernet0/3/0
    if test -e /vpp-vmxnet3-native.enabled; then
        native_ports=$(cat /vpp-vmxnet3-native-ports 2>/dev/null || echo '0000:00:02.0 0000:00:03.0')
        native_bdf1=$(printf '%s\n' $native_ports | sed -n '1p')
        native_bdf2=$(printf '%s\n' $native_ports | sed -n '2p')
        /usr/bin/vppctl -s /run/vpp/cli.sock create interface vmxnet3 "$native_bdf1" bind force > /dev/console 2>&1 || true
        test -n "$native_bdf2" && /usr/bin/vppctl -s /run/vpp/cli.sock create interface vmxnet3 "$native_bdf2" bind force > /dev/console 2>&1 || true
        vpp_if1=vmxnet3-0/2/0
        vpp_if2=vmxnet3-0/3/0
    fi
    vpp_if_list=$( /usr/bin/vppctl -s /run/vpp/cli.sock show interface 2>/dev/null \
        | awk '/^(GigabitEthernet|vmxnet3-)/ {print $1}' )
    vpp_if1=$(printf '%s\n' "$vpp_if_list" | sed -n '1p')
    vpp_if2=$(printf '%s\n' "$vpp_if_list" | sed -n '2p')
    test -n "$vpp_if1" || vpp_if1=GigabitEthernet0/2/0
    test -n "$vpp_if2" || vpp_if2=GigabitEthernet0/3/0
    if test -e /vpp-dpdk-device; then
        vpp_dpdk_device=$(cat /vpp-dpdk-device)
    else
        vpp_dpdk_device=e1000
    fi
    if test -e /vpp-dpdk-e1000.enabled || test "$vpp_dpdk_device" = vmxnet3 || test -e /vpp-dpdk-2port.enabled; then
        /usr/bin/vppctl -s /run/vpp/cli.sock set interface state "$vpp_if1" up > /dev/console 2>&1 || true
        /usr/bin/vppctl -s /run/vpp/cli.sock set interface ip address "$vpp_if1" "${VPP_IF1_ADDR:-10.10.0.1/24}" > /dev/console 2>&1 || true
        if test -e /vpp-dpdk-2port.enabled || test -e /vpp-dpdk-e1000-2port.enabled; then
            /usr/bin/vppctl -s /run/vpp/cli.sock set interface state "$vpp_if2" up > /dev/console 2>&1 || true
            /usr/bin/vppctl -s /run/vpp/cli.sock set interface ip address "$vpp_if2" "${VPP_IF2_ADDR:-10.20.0.1/24}" > /dev/console 2>&1 || true
            # The QEMU e1000 lane has deterministic peer MACs.  Install
            # static neighbors so the two-path FIB resolves to two buckets
            # without depending on an external ARP generator.
            /usr/bin/vppctl -s /run/vpp/cli.sock set ip neighbor "$vpp_if1" "${VPP_PEER_IP1:-10.10.0.2}" "${VPP_PEER_MAC1:-52:54:00:11:01:02}" > /dev/console 2>&1 || true
            /usr/bin/vppctl -s /run/vpp/cli.sock set ip neighbor "$vpp_if2" "${VPP_PEER_IP2:-10.20.0.2}" "${VPP_PEER_MAC2:-52:54:00:12:01:02}" > /dev/console 2>&1 || true
            /usr/bin/vppctl -s /run/vpp/cli.sock ip route add 30.30.30.0/24 via "${VPP_PEER_IP1:-10.10.0.2}" "$vpp_if1" via "${VPP_PEER_IP2:-10.20.0.2}" "$vpp_if2" > /dev/console 2>&1 || true
            echo "--- VPP DPDK interface addresses ---" > /dev/console
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface address > /tmp/vpp-dpdk-interface-addresses.log 2>&1 || true
            cat /tmp/vpp-dpdk-interface-addresses.log > /dev/console
            say_live_file /tmp/vpp-dpdk-interface-addresses.log
            echo "--- VPP ECMP FIB ---" > /dev/console
            /usr/bin/vppctl -s /run/vpp/cli.sock show ip fib 30.30.30.0/24 > /tmp/vpp-dpdk-ecmp-fib.log 2>&1 || true
            cat /tmp/vpp-dpdk-ecmp-fib.log > /dev/console
            say_live_file /tmp/vpp-dpdk-ecmp-fib.log
        fi
        if /usr/bin/vppctl -s /run/vpp/cli.sock show interface 2>/dev/null \
            | grep -Eq "^${vpp_if1}[[:space:]].*up" \
            && /usr/bin/vppctl -s /run/vpp/cli.sock show interface 2>/dev/null \
            | grep -Eq "^${vpp_if2}[[:space:]].*up"; then
            say_live "VPP-DPDK-INTERFACES PASS"
        else
            say_live "VPP-DPDK-INTERFACES FAIL"
        fi
        if test -e /vpp-dpdk-traffic-test.enabled; then
            say_live "--- VPP DPDK traffic test ---"
            traffic_peer_ready=1
            if test -n "${VPP_TRAFFIC_READY_ENDPOINT:-}"; then
                ready_host=${VPP_TRAFFIC_READY_ENDPOINT#tcp://}
                ready_host=${ready_host%:*}
                ready_port=${VPP_TRAFFIC_READY_ENDPOINT##*:}
                traffic_peer_ready=0
                # This is an optional traffic qualification lane, not a boot
                # prerequisite.  Keep a finite default so a live ISO without
                # its external FRR peer still reaches its local shell promptly.
                # Dedicated lab runs may explicitly request a longer window.
                ready_timeout=${VPP_TRAFFIC_READY_TIMEOUT:-15}
                ready_attempt_timeout=${VPP_TRAFFIC_READY_ATTEMPT_TIMEOUT:-3}
                say_live "VPP-TRAFFIC-PEER-READY waiting endpoint=$ready_host:$ready_port timeout=${ready_timeout}s"
                if /bin/busybox timeout "$ready_timeout" /bin/busybox sh -c '
                    while :; do
                        if /bin/busybox timeout "$3" /bin/busybox nc -w 1 "$1" "$2" \
                            </dev/null 2>/dev/null | grep -Fq FRR-DP-READY; then
                            exit 0
                        fi
                        sleep 1
                    done
                ' sh "$ready_host" "$ready_port" "$ready_attempt_timeout"; then
                    traffic_peer_ready=1
                fi
                if test "$traffic_peer_ready" = 1; then
                    say_live "VPP-TRAFFIC-PEER-READY PASS endpoint=$ready_host:$ready_port"
                else
                    say_live "VPP-TRAFFIC-PEER-READY FAIL endpoint=$ready_host:$ready_port"
                fi
            fi
            if test "$traffic_peer_ready" = 0; then
                # A missing external traffic peer must not strand the live
                # console behind a long sequence of probes with no egress.
                say_live "VPP-TRAFFIC-TEST SKIP reason=peer-not-ready"
            else
            if test "${VPP_TRAFFIC_TEST_DELAY:-0}" -gt 0; then
                say_live "VPP-TRAFFIC-SETTLE delay=${VPP_TRAFFIC_TEST_DELAY}s"
                sleep "$VPP_TRAFFIC_TEST_DELAY"
            fi
            say_live "VPP-ECMP-COUNTERS-BEFORE"
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface > /tmp/vpp-if-before.log 2>&1 || true
            say_live_file /tmp/vpp-if-before.log
            say_live "VPP-ECMP-NEIGHBORS"
            /usr/bin/vppctl -s /run/vpp/cli.sock show ip neighbor > /tmp/vpp-neighbor-before.log 2>&1 || true
            say_live_file /tmp/vpp-neighbor-before.log
            ping0_ok=0
            for ping_wait in 1 2 3 4 5; do
                if /usr/bin/vppctl -s /run/vpp/cli.sock ping "${VPP_PEER_IP1:-10.10.0.2}" repeat 3 > /tmp/vpp-ping0.log 2>&1 \
                    && grep -Fq 'Statistics: 3 sent, 3 received, 0% packet loss' /tmp/vpp-ping0.log; then
                    ping0_ok=1
                    break
                fi
                sleep 1
            done
            if test "$ping0_ok" = 1; then
                say_live "VPP-DPDK-PING-0 PASS"
            else
                say_live "VPP-DPDK-PING-0 FAIL"
            fi
            ping1_ok=0
            for ping_wait in 1 2 3 4 5; do
                if /usr/bin/vppctl -s /run/vpp/cli.sock ping "${VPP_PEER_IP2:-10.20.0.2}" repeat 3 > /tmp/vpp-ping1.log 2>&1 \
                    && grep -Fq 'Statistics: 3 sent, 3 received, 0% packet loss' /tmp/vpp-ping1.log; then
                    ping1_ok=1
                    break
                fi
                sleep 1
            done
            if test "$ping1_ok" = 1; then
                say_live "VPP-DPDK-PING-1 PASS"
            else
                say_live "VPP-DPDK-PING-1 FAIL"
            fi
            say_live_file /tmp/vpp-ping0.log
            say_live_file /tmp/vpp-ping1.log

            # Capture per-interface packet counters immediately before the
            # multi-destination ECMP probes, so unrelated startup traffic
            # cannot make a zero-forwarding ECMP run look successful.
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if1" > /tmp/vpp-ecmp-if0-before.log 2>&1 || true
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if2" > /tmp/vpp-ecmp-if1-before.log 2>&1 || true
            ecmp_if0_before=$(awk '$1 == "rx" && $2 == "packets" {rx=$3} $1 == "tx" && $2 == "packets" {tx=$3} END {printf "%d %d", rx, tx}' /tmp/vpp-ecmp-if0-before.log)
            ecmp_if1_before=$(awk '$1 == "rx" && $2 == "packets" {rx=$3} $1 == "tx" && $2 == "packets" {tx=$3} END {printf "%d %d", rx, tx}' /tmp/vpp-ecmp-if1-before.log)
            set -- $ecmp_if0_before; ecmp_if0_rx_before=$1; ecmp_if0_tx_before=$2
            set -- $ecmp_if1_before; ecmp_if1_rx_before=$1; ecmp_if1_tx_before=$2

            ecmp_multi_ok=$traffic_peer_ready
            ecmp_fib_file=/tmp/vpp-ecmp-fib.log
            /usr/bin/vppctl -s /run/vpp/cli.sock show ip fib 30.30.30.0/24 > "$ecmp_fib_file" 2>&1 || true
            if ! grep -Eq 'dpo-load-balance:.*buckets:([2-9]|[1-9][0-9]+)' "$ecmp_fib_file" \
                || grep -q 'dpo-drop' "$ecmp_fib_file"; then
                ecmp_multi_ok=0
                say_live "VPP-ECMP-FIB FAIL (no resolved multi-bucket forwarding DPO)"
            else
                ecmp_bucket_count=$(sed -n 's/.*dpo-load-balance:.*buckets:\([0-9][0-9]*\).*/\1/p' "$ecmp_fib_file" | head -1)
                say_live "VPP-ECMP-FIB PASS buckets=$ecmp_bucket_count"
            fi
            # Use an address from the tested destination subnet as the probe
            # source. Each FRR peer can then return directly on its own
            # dataplane link, independent of which ECMP bucket handled the
            # request; a management-side source would force asymmetric return
            # routing through the FRR peer link.
            /usr/bin/vppctl -s /run/vpp/cli.sock create loopback interface \
                > /tmp/vpp-ecmp-loopback.log 2>&1 || true
            ecmp_source_if=$(sed -n 's/^\(loop[0-9][0-9]*\).*/\1/p' \
                /tmp/vpp-ecmp-loopback.log | head -1)
            if test -z "$ecmp_source_if"; then
                ecmp_source_if=$(/usr/bin/vppctl -s /run/vpp/cli.sock show interface 2>/dev/null \
                    | awk '$1 ~ /^loop[0-9]+$/ {print $1; exit}')
            fi
            ecmp_source_ready=0
            if test -n "$ecmp_source_if"; then
                /usr/bin/vppctl -s /run/vpp/cli.sock set interface state \
                    "$ecmp_source_if" up >/dev/null 2>&1 || true
                /usr/bin/vppctl -s /run/vpp/cli.sock set interface ip address \
                    "$ecmp_source_if" 30.30.30.1/32 >/dev/null 2>&1 || true
                if /usr/bin/vppctl -s /run/vpp/cli.sock show interface address 2>/dev/null \
                    | grep -Fq '30.30.30.1/32'; then
                    ecmp_source_ready=1
                    say_live "VPP-ECMP-SOURCE PASS address=30.30.30.1 interface=$ecmp_source_if"
                fi
            fi
            test "$ecmp_source_ready" = 1 || say_live "VPP-ECMP-SOURCE FAIL"
            for ecmp_dst in 30.30.30.2 30.30.30.3 30.30.30.4 30.30.30.5; do
                if test "$ecmp_source_ready" != 1 \
                    || ! /usr/bin/vppctl -s /run/vpp/cli.sock ping "$ecmp_dst" source "$ecmp_source_if" repeat 3 > /tmp/vpp-ecmp-${ecmp_dst}.log 2>&1 \
                    || ! grep -Fq 'Statistics: 3 sent, 3 received, 0% packet loss' /tmp/vpp-ecmp-${ecmp_dst}.log; then
                    ecmp_multi_ok=0
                    say_live "VPP-ECMP-FLOW FAIL target=$ecmp_dst"
                else
                    say_live "VPP-ECMP-FLOW target=$ecmp_dst tx=3 rx=3 loss=0"
                fi
                say_live_file /tmp/vpp-ecmp-${ecmp_dst}.log
            done
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if1" > /tmp/vpp-ecmp-if0-after.log 2>&1 || true
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if2" > /tmp/vpp-ecmp-if1-after.log 2>&1 || true
            ecmp_if0_after=$(awk '$1 == "rx" && $2 == "packets" {rx=$3} $1 == "tx" && $2 == "packets" {tx=$3} END {printf "%d %d", rx, tx}' /tmp/vpp-ecmp-if0-after.log)
            ecmp_if1_after=$(awk '$1 == "rx" && $2 == "packets" {rx=$3} $1 == "tx" && $2 == "packets" {tx=$3} END {printf "%d %d", rx, tx}' /tmp/vpp-ecmp-if1-after.log)
            set -- $ecmp_if0_after; ecmp_if0_rx_after=$1; ecmp_if0_tx_after=$2
            set -- $ecmp_if1_after; ecmp_if1_rx_after=$1; ecmp_if1_tx_after=$2
            ecmp_bucket0_delta=$((ecmp_if0_rx_after - ecmp_if0_rx_before + ecmp_if0_tx_after - ecmp_if0_tx_before))
            ecmp_bucket1_delta=$((ecmp_if1_rx_after - ecmp_if1_rx_before + ecmp_if1_tx_after - ecmp_if1_tx_before))
            say_live "VPP-ECMP-BUCKETS bucket0_packets=$ecmp_bucket0_delta bucket1_packets=$ecmp_bucket1_delta"
            if test "$ecmp_bucket0_delta" -le 0 || test "$ecmp_bucket1_delta" -le 0; then
                ecmp_multi_ok=0
            fi
            if test "$ecmp_multi_ok" = 1; then
                say_live "VPP-ECMP-MULTI-FLOW PASS"
            else
                say_live "VPP-ECMP-MULTI-FLOW FAIL"
            fi
            ecmp_failover_ok=1
            say_live "VPP-ECMP-PATH-DOWN BEGIN interface=$vpp_if2"
            if /usr/bin/vppctl -s /run/vpp/cli.sock set interface state "$vpp_if2" down \
                >/tmp/vpp-ecmp-path-down.log 2>&1; then
                sleep 2
                /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if2" \
                    > /tmp/vpp-ecmp-path-down-state.log 2>&1 || true
                say_live_file /tmp/vpp-ecmp-path-down-state.log
                if ! grep -Eq "^${vpp_if2}[[:space:]].*down" /tmp/vpp-ecmp-path-down-state.log; then
                    ecmp_failover_ok=0
                fi
                if /usr/bin/vppctl -s /run/vpp/cli.sock ip route del 30.30.30.0/24 \
                    via "${VPP_PEER_IP2:-10.20.0.2}" "$vpp_if2" \
                    >/tmp/vpp-ecmp-path-withdraw.log 2>&1; then
                    say_live "VPP-ECMP-NH-WITHDRAW PASS nexthop=${VPP_PEER_IP2:-10.20.0.2} interface=$vpp_if2"
                else
                    ecmp_failover_ok=0
                    say_live "VPP-ECMP-NH-WITHDRAW FAIL nexthop=${VPP_PEER_IP2:-10.20.0.2} interface=$vpp_if2"
                fi
                say_live_file /tmp/vpp-ecmp-path-withdraw.log
                /usr/bin/vppctl -s /run/vpp/cli.sock show ip fib 30.30.30.0/24 \
                    > /tmp/vpp-ecmp-path-down-fib.log 2>&1 || true
                down_buckets=$(sed -n 's/.*dpo-load-balance:.*buckets:\([0-9][0-9]*\).*/\1/p' \
                    /tmp/vpp-ecmp-path-down-fib.log | head -1)
                say_live "VPP-ECMP-PATH-DOWN-BUCKETS buckets=${down_buckets:-0}"
                say_live "VPP-ECMP-PATH-DOWN-FIB"
                say_live_file /tmp/vpp-ecmp-path-down-fib.log
                /usr/bin/vppctl -s /run/vpp/cli.sock show ip neighbor \
                    > /tmp/vpp-ecmp-path-down-neighbors.log 2>&1 || true
                say_live "VPP-ECMP-PATH-DOWN-NEIGHBORS"
                say_live_file /tmp/vpp-ecmp-path-down-neighbors.log
                if test "${down_buckets:-0}" != 1; then
                    ecmp_failover_ok=0
                fi
                sleep 2
                for ecmp_dst in 30.30.30.2 30.30.30.3 30.30.30.4 30.30.30.5; do
                    if /usr/bin/vppctl -s /run/vpp/cli.sock ping "$ecmp_dst" \
                        source "$ecmp_source_if" repeat 5 interval 0.2 > "/tmp/vpp-ecmp-down-${ecmp_dst}.log" 2>&1 \
                        && grep -Fq 'Statistics: 5 sent, 5 received, 0% packet loss' \
                            "/tmp/vpp-ecmp-down-${ecmp_dst}.log"; then
                        say_live "VPP-ECMP-PATH-DOWN-FLOW target=$ecmp_dst tx=5 rx=5 loss=0"
                    else
                        ecmp_failover_ok=0
                        say_live "VPP-ECMP-PATH-DOWN-FLOW-FAIL target=$ecmp_dst"
                    fi
                    say_live_file "/tmp/vpp-ecmp-down-${ecmp_dst}.log"
                done
            else
                ecmp_failover_ok=0
                say_live "VPP-ECMP-PATH-DOWN-FAIL interface=$vpp_if2"
                say_live_file /tmp/vpp-ecmp-path-down.log
            fi
            # Always restore the dataplane port, even when failover probes fail.
            if ! /usr/bin/vppctl -s /run/vpp/cli.sock set interface state "$vpp_if2" up \
                >/tmp/vpp-ecmp-path-up.log 2>&1; then
                ecmp_failover_ok=0
                say_live "VPP-ECMP-PATH-UP-FAIL interface=$vpp_if2"
                say_live_file /tmp/vpp-ecmp-path-up.log
            fi
            if /usr/bin/vppctl -s /run/vpp/cli.sock ip route add 30.30.30.0/24 \
                via "${VPP_PEER_IP2:-10.20.0.2}" "$vpp_if2" \
                >/tmp/vpp-ecmp-path-restore.log 2>&1; then
                say_live "VPP-ECMP-NH-RESTORE PASS nexthop=${VPP_PEER_IP2:-10.20.0.2} interface=$vpp_if2"
            else
                ecmp_failover_ok=0
                say_live "VPP-ECMP-NH-RESTORE FAIL nexthop=${VPP_PEER_IP2:-10.20.0.2} interface=$vpp_if2"
            fi
            say_live_file /tmp/vpp-ecmp-path-restore.log
            sleep 3
            ecmp_restored_buckets=0
            for ecmp_restore_wait in $(seq 1 30); do
                /usr/bin/vppctl -s /run/vpp/cli.sock show interface "$vpp_if2" \
                    > /tmp/vpp-ecmp-path-up-state.log 2>&1 || true
                /usr/bin/vppctl -s /run/vpp/cli.sock show ip fib 30.30.30.0/24 \
                    > /tmp/vpp-ecmp-path-up-fib.log 2>&1 || true
                ecmp_restored_buckets=$(sed -n 's/.*dpo-load-balance:.*buckets:\([0-9][0-9]*\).*/\1/p' \
                    /tmp/vpp-ecmp-path-up-fib.log | head -1)
                if grep -Eq "^${vpp_if2}[[:space:]]+[0-9]+[[:space:]]+up[[:space:]]" /tmp/vpp-ecmp-path-up-state.log \
                    && test "${ecmp_restored_buckets:-0}" -ge 2; then
                    break
                fi
                sleep 1
            done
            say_live_file /tmp/vpp-ecmp-path-up-state.log
            say_live "VPP-ECMP-PATH-UP-FIB"
            say_live_file /tmp/vpp-ecmp-path-up-fib.log
            if ! grep -Eq "^${vpp_if2}[[:space:]]+[0-9]+[[:space:]]+up[[:space:]]" /tmp/vpp-ecmp-path-up-state.log \
                || test "${ecmp_restored_buckets:-0}" -lt 2; then
                ecmp_failover_ok=0
            fi
            # Prime neighbor/adjacency resolution after rejoining the path;
            # then begin the measured restore probes with a fresh ping flow.
            /usr/bin/vppctl -s /run/vpp/cli.sock ping 10.20.0.2 repeat 2 interval 0.2 \
                >/tmp/vpp-ecmp-path-up-prime.log 2>&1 || true
            sleep 2
            for ecmp_dst in 30.30.30.2 30.30.30.3 30.30.30.4 30.30.30.5; do
                if /usr/bin/vppctl -s /run/vpp/cli.sock ping "$ecmp_dst" \
                    source "$ecmp_source_if" repeat 5 interval 0.2 > "/tmp/vpp-ecmp-up-${ecmp_dst}.log" 2>&1 \
                    && grep -Fq 'Statistics: 5 sent, 5 received, 0% packet loss' \
                        "/tmp/vpp-ecmp-up-${ecmp_dst}.log"; then
                    say_live "VPP-ECMP-PATH-UP-FLOW target=$ecmp_dst tx=5 rx=5 loss=0"
                else
                    ecmp_failover_ok=0
                    say_live "VPP-ECMP-PATH-UP-FLOW-FAIL target=$ecmp_dst"
                fi
                say_live_file "/tmp/vpp-ecmp-up-${ecmp_dst}.log"
            done
            if test "$ecmp_failover_ok" = 1; then
                say_live "VPP-ECMP-PATH-FAILOVER PASS interface=$vpp_if2 probes=20"
                say_live "VPP-ECMP-PATH-RESTORE PASS interface=$vpp_if2 buckets=$ecmp_restored_buckets probes=20"
            else
                say_live "VPP-ECMP-PATH-FAILOVER FAIL interface=$vpp_if2"
                say_live "VPP-ECMP-PATH-RESTORE FAIL interface=$vpp_if2 buckets=${ecmp_restored_buckets:-0}"
            fi
            say_live "VPP-ECMP-COUNTERS-AFTER"
            /usr/bin/vppctl -s /run/vpp/cli.sock show interface > /tmp/vpp-if-after.log 2>&1 || true
            say_live_file /tmp/vpp-if-after.log
            say_live "VPP-ECMP-DISTRIBUTION PARTIAL (per-interface packet deltas captured; remote high-rate generator required)"
        fi
            fi
    fi
    /usr/bin/vppctl -s /run/vpp/cli.sock show interface > /dev/console 2>&1 || true
    /usr/bin/vppctl -s /run/vpp/cli.sock show hardware-interfaces > /dev/console 2>&1 || true
    if test -e /danos-fib-bridge.enabled && test -x /bin/fib_live_bridge \
        && test -r /etc/danos/bridge.env; then
        . /etc/danos/bridge.env
        # Start the persistent bridge immediately. It reconnects on its own;
        # waiting here would delay the local console when FRR is absent.
        bridge_host=${DANOS_ZEBRA_ENDPOINT#tcp://}
        bridge_host=${bridge_host%:*}
        bridge_port=${DANOS_ZEBRA_ENDPOINT##*:}
        if /bin/busybox nc -w 1 "$bridge_host" "$bridge_port" \
            </dev/null >/dev/null 2>&1; then
            say_live "FRR-ZAPI-ENDPOINT ready=$bridge_host:$bridge_port"
        else
            say_live "FRR-ZAPI-ENDPOINT unavailable=$bridge_host:$bridge_port reconnect=enabled"
        fi
        echo "FRR bridge link state" > /dev/console
        ip addr show eth0 > /dev/console 2>&1 || true
        ip route show > /dev/console 2>&1 || true
        /bin/busybox ping -c 1 -W 1 "$bridge_host" > /dev/console 2>&1 || true
        echo "--- starting optional FRR ZAPI bridge" > /dev/console
        bridge_skip_vpp_recovery="${DANOS_SKIP_VPP_RECOVERY:-0}"
        if test "${DANOS_VPP_RESTART_TEST:-0}" != 0; then
            bridge_skip_vpp_recovery=0
        fi
        bridge_vpp_health_probe="${DANOS_VPP_HEALTH_PROBE:-0}"
        if test "${DANOS_VPP_RESTART_TEST:-0}" != 0; then
            bridge_vpp_health_probe=1
        fi
        (
            DANOS_ZAPI_DEBUG=1 DANOS_VPP_DEBUG=1 DANOS_ZAPI_HELLO_ONLY="${DANOS_ZAPI_HELLO_ONLY:-0}" \
                DANOS_ZAPI_REG_STAGE="${DANOS_ZAPI_REG_STAGE:-0}" \
                DANOS_ZAPI_PACE_US="${DANOS_ZAPI_PACE_US:-0}" \
                DANOS_SKIP_VPP_RECOVERY="$bridge_skip_vpp_recovery" \
                DANOS_VPP_HEALTH_PROBE="$bridge_vpp_health_probe" \
                DANOS_VPP_RESTART_TEST="${DANOS_VPP_RESTART_TEST:-0}" \
                DANOS_ZAPI_ROUTE_TYPES="${DANOS_ZAPI_ROUTE_TYPES:-4,10}" \
                DANOS_ZAPI_PROTOCOL="${DANOS_ZAPI_PROTOCOL:-3}" \
                DANOS_ZAPI_REDISTRIBUTE_DEFAULT="${DANOS_ZAPI_REDISTRIBUTE_DEFAULT:-0}" \
                DANOS_VPP_IFINDEX_MAP='2:1,3:2,4:1,5:2' /bin/fib_live_bridge \
                --zebra-sock "$DANOS_ZEBRA_ENDPOINT" \
                --vpp-sock /run/vpp/api.sock --messages 0 --reconnect 2>&1 \
                | tee /var/log/fib_live_bridge.log /dev/tty0 /dev/ttyS0 >/dev/null
        ) &
        echo "FRR bridge started: $DANOS_ZEBRA_ENDPOINT" > /dev/console
    fi
    echo "VPP-RESTART-TEST MODE=${DANOS_VPP_RESTART_TEST:-0}" > /dev/console
    if test "${DANOS_VPP_RESTART_TEST:-0}" != 0; then
        (
            echo "VPP-RESTART-TEST SCHEDULED" > /dev/console
            sleep 120
            echo "VPP-RESTART-TEST BEGIN" | tee /dev/console /dev/ttyS0 >/dev/null
            recovery_log=/var/log/fib_live_bridge.log
            recovery_log_start=0
            if test -f "$recovery_log"; then
                recovery_log_start=$(wc -l < "$recovery_log")
            fi
            vpp_pid=$(pidof vpp 2>/dev/null || true)
            if test -n "$vpp_pid"; then kill "$vpp_pid" 2>/dev/null || true; fi
            for restart_wait in $(seq 1 20); do
                test ! -S /run/vpp/api.sock && break
                sleep 1
            done
            rm -f /run/vpp/api.sock /run/vpp/cli.sock /run/vpp/stats.sock
            /usr/bin/vpp -c /etc/vpp/startup.conf >/var/log/vpp/vpp-restart.log 2>&1 &
            for restart_wait in $(seq 1 30); do
                test -S /run/vpp/api.sock && break
                sleep 1
            done
        restart_ok=0
        for restart_check in $(seq 1 120); do
            replay_log=/var/log/fib_live_bridge.log
            replay_start=${recovery_log_start:-0}
            if test -S /run/vpp/api.sock && test -f "$replay_log" && \
               tail -n +$((replay_start + 1)) "$replay_log" 2>/dev/null | \
               grep -q 'VPP backend recovery: replay attempted=[0-9][0-9]* failed=0'; then
                restart_ok=1
                break
            fi
            sleep 1
        done
        if test "$restart_ok" = 1; then
                echo "VPP-RESTART-TEST PASS" | tee /dev/console /dev/ttyS0 >/dev/null
            else
                echo "VPP-RESTART-TEST FAIL" | tee /dev/console /dev/ttyS0 >/dev/null
                tail -n 80 /var/log/vpp/vpp-restart.log > /dev/console 2>&1 || true
            fi
        ) &
    fi
fi

export MGRD_NETLINK_REAL=1   # VM root: program the real kernel
echo "--- starting mgrd (gNMI :59200, metrics :59201, netlink real)"
mgrd --port 59200 --metrics-port 59201 --wal /tmp/mgrd.wal --seed &
sleep 1

# K4-in-VM: provision a route via gNMI and show the kernel FIB
(
    sleep 2
    if ! command -v gnmic >/dev/null 2>&1; then
        echo "--- [demo] gnmic unavailable; skipping gNMI route demo" > /dev/console
        exit 0
    fi
    echo "--- [demo] gnmic set route 172.16.0.0/16 via 10.0.2.2"
    gnmic -a 127.0.0.1:59200 --insecure set \
        --update '/routes/route[prefix=172.16.0.0/16]:::json_ietf:::{"gateway":"10.0.2.2"}' \
        > /dev/console 2>&1
    sleep 2
    echo "--- [demo] kernel FIB (ip route show):"
    ip route show > /dev/console 2>&1
    echo "--- [demo] kernel FIB (/proc/net/route):"
    cat /proc/net/route > /dev/console 2>&1
) &

say_live "--- live system ready. shell:"
say_live "LIVE-SHELL-READY"
# Bind the interactive shell to tty1 when a local VGA keyboard is present.
# /dev/console is a valid output sink but may not provide a controlling tty,
# which leaves a physical USB keyboard unable to deliver input.
if test -c /dev/tty1; then
    # cttyhack makes tty1 the controlling terminal, which is required for
    # local USB keyboard input when PID 1 launches the shell.
    /bin/busybox setsid /bin/busybox cttyhack /bin/busybox sh \
        </dev/tty1 >/dev/tty1 2>&1 || true
else
    /bin/busybox sh </dev/console >/dev/console 2>&1 || true
fi
while :; do sleep 3600; done
